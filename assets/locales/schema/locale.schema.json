{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalforge.local/schema/locale.schema.json",
  "title": "MetalForge 界面语言",
  "description": "驱动全部用户可见文案。C# 与 XAML 中不得出现面向用户的字符串字面量；界面通过键名查询，例如 menu.file.newProject。",
  "type": "object",
  "required": ["language", "strings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP-47 语言代码，例如 zh-Hans、en、pt-BR"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 60, "description": "面向用户的语言名称（用该语言自身书写）" },
    "rightToLeft": { "type": "boolean" },
    "strings": {
      "type": "object",
      "description": "嵌套的文案表；叶子必须是字符串。分组名建议与界面区域对应（menu / panel / status / ...）。",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/group" }
        ]
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/group" }
        ]
      }
    }
  }
}
