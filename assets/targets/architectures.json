{
  "$schema": "./schema/architectures.schema.json",
  "version": 1,
  "architectures": [
    {
      "id": "x86_64",
      "displayName": "x86_64",
      "description": "AMD/Intel 64 位。从固件、引导到内核最常见的起点。",
      "targetTriple": "x86_64-elf",
      "alternativeTargetTriples": ["x86_64-w64-mingw32"],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 64,
      "endianness": "little",
      "defaultBootMethodId": "multiboot2",
      "supportedBootMethodIds": ["uefi", "multiboot2", "multiboot", "bios_mbr", "coreboot", "edk2_module", "direct_bare"],
      "defaultArtifactKind": "bootable.iso",
      "qemuSystemExecutable": "qemu-system-x86_64",
      "qemuMachine": "q35",
      "qemuCpu": "qemu64",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-mno-red-zone", "-mno-sse"],
      "abiNotes": "System V AMD64 ABI；内核通常需要 -mcmodel=kernel 或高半区链接脚本。"
    },
    {
      "id": "i686",
      "displayName": "i686",
      "description": "32 位 x86。教学与 BIOS 引导场景仍然常见。",
      "targetTriple": "i686-elf",
      "alternativeTargetTriples": ["i686-w64-mingw32"],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 32,
      "endianness": "little",
      "defaultBootMethodId": "multiboot",
      "supportedBootMethodIds": ["multiboot", "multiboot2", "bios_mbr", "coreboot", "direct_bare"],
      "defaultArtifactKind": "bootable.iso",
      "qemuSystemExecutable": "qemu-system-i386",
      "qemuMachine": "pc",
      "qemuCpu": "qemu32",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-fno-pic"],
      "abiNotes": "cdecl；注意 32 位下没有 red zone 概念。"
    },
    {
      "id": "aarch64",
      "displayName": "AArch64 (ARM64)",
      "description": "64 位 ARM。异常级别（EL1–EL3）与内存模型和 x86 差异较大。",
      "targetTriple": "aarch64-elf",
      "alternativeTargetTriples": ["aarch64-none-elf"],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 64,
      "endianness": "little",
      "defaultBootMethodId": "direct_bare",
      "supportedBootMethodIds": ["uefi", "u_boot", "edk2_module", "direct_bare"],
      "defaultArtifactKind": "kernel.elf",
      "qemuSystemExecutable": "qemu-system-aarch64",
      "qemuMachine": "virt",
      "qemuCpu": "cortex-a57",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-mgeneral-regs-only"],
      "abiNotes": "AAPCS64；启动需自行设置栈与异常向量表（VBAR_EL1）。"
    },
    {
      "id": "arm32",
      "displayName": "ARM32 (Cortex-A)",
      "description": "32 位 ARM 应用级内核。",
      "targetTriple": "arm-none-eabi",
      "alternativeTargetTriples": ["arm-linux-gnueabihf"],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 32,
      "endianness": "little",
      "defaultBootMethodId": "direct_bare",
      "supportedBootMethodIds": ["u_boot", "direct_bare"],
      "defaultArtifactKind": "kernel.elf",
      "qemuSystemExecutable": "qemu-system-arm",
      "qemuMachine": "virt",
      "qemuCpu": "cortex-a15",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-marm"],
      "abiNotes": "ARM/Thumb 切换需显式处理；异常向量基址可重定位。"
    },
    {
      "id": "riscv64",
      "displayName": "RISC-V (rv64)",
      "description": "64 位 RISC-V。常见做法是以 OpenSBI 作为 -bios 运行 S 态内核。",
      "targetTriple": "riscv64-elf",
      "alternativeTargetTriples": ["riscv64-unknown-elf"],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 64,
      "endianness": "little",
      "defaultBootMethodId": "direct_bare",
      "supportedBootMethodIds": ["u_boot", "direct_bare"],
      "defaultArtifactKind": "kernel.elf",
      "qemuSystemExecutable": "qemu-system-riscv64",
      "qemuMachine": "virt",
      "qemuCpu": "rv64",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-mcmodel=medany", "-march=rv64gc", "-mabi=lp64d"],
      "abiNotes": "S 态内核需处理 satp 与陷阱向量（stvec）。"
    },
    {
      "id": "riscv32",
      "displayName": "RISC-V (rv32)",
      "description": "32 位 RISC-V。嵌入式与教学场景。",
      "targetTriple": "riscv32-elf",
      "alternativeTargetTriples": ["riscv32-unknown-elf"],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 32,
      "endianness": "little",
      "defaultBootMethodId": "direct_bare",
      "supportedBootMethodIds": ["u_boot", "openocd_flash", "direct_bare"],
      "defaultArtifactKind": "kernel.elf",
      "qemuSystemExecutable": "qemu-system-riscv32",
      "qemuMachine": "virt",
      "qemuCpu": "rv32",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-march=rv32imac", "-mabi=ilp32"],
      "abiNotes": "注意长指令与压缩指令混用时的对齐要求。"
    },
    {
      "id": "cortex_m",
      "displayName": "Cortex-M",
      "description": "ARM 微控制器（M0–M33）。无 MMU，向量表固定，交付物通常是 .hex 或 .uf2。",
      "targetTriple": "arm-none-eabi",
      "alternativeTargetTriples": [],
      "preferredToolchainId": "gcc-cross",
      "alternativeToolchainIds": ["clang"],
      "bitness": 32,
      "endianness": "little",
      "defaultBootMethodId": "direct_bare",
      "supportedBootMethodIds": ["direct_bare", "openocd_flash"],
      "defaultArtifactKind": "firmware.uf2",
      "qemuSystemExecutable": "qemu-system-arm",
      "qemuMachine": "mps2-an385",
      "qemuCpu": "cortex-m3",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector", "-mcpu=cortex-m3", "-mthumb", "-nostartfiles"],
      "abiNotes": "链接脚本需定义 _estack 与向量表；(void(*)(void)) 复位处理函数约定与 ARM 不同。"
    },
    {
      "id": "esp32",
      "displayName": "ESP32",
      "description": "乐鑫 SoC。Xtensa 或 RISC-V 核心 + 二级引导加载程序。",
      "targetTriple": "xtensa-esp32-elf",
      "alternativeTargetTriples": ["riscv32-esp-elf"],
      "preferredToolchainId": "esp-idf",
      "alternativeToolchainIds": [],
      "bitness": 32,
      "endianness": "little",
      "defaultBootMethodId": "direct_bare",
      "supportedBootMethodIds": ["direct_bare", "openocd_flash"],
      "defaultArtifactKind": "firmware.bin",
      "qemuSystemExecutable": "qemu-system-xtensa",
      "qemuMachine": "esp32",
      "qemuCpu": "esp32",
      "requiredCompilerFlags": ["-ffreestanding", "-fno-stack-protector"],
      "abiNotes": "需要分区表 CSV 与 esptool 烧录；ESP32-S3/C3 为 RISC-V 核心，工具链不同。"
    }
  ]
}
