{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalforge.local/schema/theme.schema.json",
  "title": "MetalForge 主题",
  "description": "驱动全部视觉参数。C# 与 XAML 中禁止出现颜色/尺寸字面量，一切经由本文件。",
  "type": "object",
  "required": ["id", "displayName", "variant", "palette", "metrics"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "variant": { "enum": ["dark", "light", "high-contrast"] },
    "extends": { "type": "string", "description": "继承的父主题 id（可选，用于派生高对比度变体）" },
    "palette": {
      "type": "object",
      "description": "颜色一律使用 #RRGGBB 或 #AARRGGBB；禁止命名颜色。",
      "additionalProperties": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "surfaceRaised": { "type": "string" },
        "surfaceSunken": { "type": "string" },
        "foreground": { "type": "string" },
        "foregroundMuted": { "type": "string" },
        "foregroundDisabled": { "type": "string" },
        "accent": { "type": "string" },
        "accentHover": { "type": "string" },
        "accentPressed": { "type": "string" },
        "border": { "type": "string" },
        "borderStrong": { "type": "string" },
        "selection": { "type": "string" },
        "success": { "type": "string" },
        "warning": { "type": "string" },
        "danger": { "type": "string" },
        "info": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["cornerRadius", "spacingUnit", "fontSizeBase"],
      "additionalProperties": false,
      "properties": {
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 24 },
        "cornerRadiusSmall": { "type": "number", "minimum": 0, "maximum": 24 },
        "spacingUnit": { "type": "number", "minimum": 1, "maximum": 16 },
        "fontSizeBase": { "type": "number", "minimum": 9, "maximum": 24 },
        "fontSizeSmall": { "type": "number", "minimum": 8, "maximum": 20 },
        "fontSizeHeading": { "type": "number", "minimum": 11, "maximum": 40 },
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "panelPadding": { "type": "number", "minimum": 0, "maximum": 32 },
        "toolbarHeight": { "type": "number", "minimum": 24, "maximum": 72 },
        "statusBarHeight": { "type": "number", "minimum": 18, "maximum": 48 },
        "tabHeight": { "type": "number", "minimum": 20, "maximum": 56 }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 9, "maximum": 32 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 3 },
        "showLineNumbers": { "type": "boolean" },
        "highlightCurrentLine": { "type": "boolean" },
        "wordWrap": { "type": "boolean" },
        "tabSize": { "type": "integer", "minimum": 1, "maximum": 16 },
        "convertTabsToSpaces": { "type": "boolean" }
      }
    },
    "syntax": {
      "type": "object",
      "description": "编辑器语法高亮颜色角色。XSHD 只接受具体颜色值，因此由主题生成定义文件。默认取值对齐 VS Code Dark+/Light+ 的公开基准配色（低对比度是刻意设计，长时间阅读更省力）。",
      "additionalProperties": false,
      "properties": {
        "comment": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "string": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "number": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "keyword": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "instruction": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "register": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "directive": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "label": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "function": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "variable": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "preprocessor": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 28 },
        "ansiPalette": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
        }
      }
    }
  }
}
