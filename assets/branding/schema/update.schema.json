{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalforge.local/schema/update.schema.json",
  "title": "MetalForge 更新检查配置",
  "description": "默认只提示不下载、不安装。更新包必须通过签名验证。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "enabled": { "type": "boolean" },
    "checkOnStartup": { "type": "boolean" },
    "channel": { "enum": ["stable", "beta", "alpha"] },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["stable", "beta", "alpha"] }
    },
    "endpoint": { "type": "string", "maxLength": 500 },
    "requestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
    "changelogSource": { "type": "string", "maxLength": 300 },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "publicKeyPemFile": { "type": "string", "maxLength": 300 },
        "algorithm": { "type": "string", "maxLength": 60 }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "downloadAutomatically": { "type": "boolean" },
        "installAutomatically": { "type": "boolean" },
        "notifyOnly": { "type": "boolean" },
        "allowUserToDisable": { "type": "boolean" }
      }
    }
  }
}
