{
  "$schema": "./schema/update.schema.json",
  "enabled": true,
  "checkOnStartup": true,
  "channel": "stable",
  "channels": ["stable", "beta", "alpha"],
  "endpoint": "https://api.github.com/repos/MingzeKX/MetalForge/releases/latest",
  "requestTimeoutSeconds": 10,
  "changelogSource": "branding/changelog.json",
  "signing": {
    "required": true,
    "publicKeyPemFile": "branding/update-public-key.pem",
    "algorithm": "RSA-SHA256"
  },
  "behavior": {
    "downloadAutomatically": false,
    "installAutomatically": false,
    "notifyOnly": true,
    "allowUserToDisable": true
  }
}
