<Project>

  <!--
    中央包版本管理（CPM）。任何新依赖必须先：
      1) 在 DEPENDENCIES.md 记录：版本、理由、许可证、最近更新时间、备选
      2) 在此处登记版本
      3) 若 >5MB 或影响架构，先取得用户确认
    版本核查日期：2026-02（来源：api.nuget.org flat-container 实测）
  -->
  <PropertyGroup>
    <!-- UI 框架：Avalonia 12 系列，必须整组同版本 -->
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- 编辑器：AvaloniaEdit 12.0.0（旧包 AvaloniaEdit 0.10.12 已停更，禁止使用） -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="基础设施">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

</Project>
