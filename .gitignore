# ---------------------------------------------------------------------------
# MetalForge .gitignore
# 规则：源码树永远干净，一切产物进 build/（已忽略）
# ---------------------------------------------------------------------------

# 构建产物（本项目约定：所有输出重定向到 build/）
build/
artifacts/
[Bb]in/
[Oo]bj/
*.binlog
*.tlog
project.lock.json
*.nuget.g.props
*.nuget.g.targets

# 测试与覆盖率
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.trx

# IDE / 编辑器
.vs/
.vscode/*
!.vscode/settings.json.sample
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user
*.sln.docstates

# OSDev 本地运行产物（不属于源码）
*.iso
*.img
*.efi
*.uf2
*.o
*.obj
*.a
*.elf.map
*.dSYM/

# 注意：tests/fixtures 下的测试用二进制是有意提交的，见下方例外
!tests/fixtures/**

# 发布与打包
publish/
*.nupkg
*.snupkg
*.msi
*.zip
*.7z

# 本地密钥与配置（绝不入库）
*.secrets.json
secrets.json
.metalforge/local/

# 工具链托管目录（应用内下载的工具，机器相关）
tools/

# 操作系统噪声
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
