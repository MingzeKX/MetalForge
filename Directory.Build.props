<Project>

  <!--
    全局构建约定。所有项目共享，避免逐项目重复。
    约束：不要把与具体项目相关的设置塞进来。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseArtifactsOutput>false</UseArtifactsOutput>

    <!-- 源码树保持干净：所有产物集中到仓库根的 build/<Configuration>/<Project>/ -->
    <RepoRootPath>$(MSBuildThisFileDirectory)</RepoRootPath>
    <BaseOutputPath>$(RepoRootPath)build\$(Configuration)\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRootPath)build\$(Configuration)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>

    <!-- 质量底线：警告即错误，异常不许吞 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- 版本真相源：发布时由 CI 或 -p:Version= 覆盖 -->
    <VersionPrefix>0.0.2</VersionPrefix>
    <Company>MetalForge</Company>
    <Product>MetalForge</Product>
    <Authors>MetalForge Contributors</Authors>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <!-- 中央包版本管理：唯一版本真相源为 Directory.Packages.props -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

</Project>
