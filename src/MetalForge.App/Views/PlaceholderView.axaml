<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MetalForge.App.ViewModels"
             x:Class="MetalForge.App.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Spacing="8" Margin="16" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640">
    <TextBlock Classes="heading" Text="{Binding Title}" />
    <TextBlock Classes="body" Text="{Binding Message}" />
    <TextBlock Classes="mono" FontSize="{DynamicResource MfFontSizeSmall}"
               Foreground="{DynamicResource MfAccent}" Text="{Binding PlannedMilestone}" />
    <TextBlock Classes="body" FontSize="{DynamicResource MfFontSizeSmall}" Text="{Binding Note}" />
  </StackPanel>
</UserControl>
