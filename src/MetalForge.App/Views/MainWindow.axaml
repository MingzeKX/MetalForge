<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MetalForge.App.ViewModels"
        x:Class="MetalForge.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource MfBackground}"
        Width="1280" Height="720">
  <!--
    经典 IDE 布局的容器：菜单条（可选）、工具栏（可选）、中央面板树、状态栏（可选）。
    中央那棵树由 LayoutControlBuilder 从 assets/layouts/*.layout.json 构建，
    因此这里没有硬编码的栏位结构。

    菜单条刻意不用 Avalonia 的 Menu 控件，而是 Button + Flyout：
    Menu 的默认模板内建了下拉箭头，且模板部件未公开，无法通过样式去掉。
    IDE 的惯例是"点击标题弹出列表"（同 Windows 右键菜单），没有箭头。
  -->
  <DockPanel LastChildFill="True">

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom"
            Classes="app-statusbar"
            IsVisible="{Binding ShowStatusBar}"
            Height="{DynamicResource MfStatusBarHeight}">
      <Grid ColumnDefinitions="Auto,*" Margin="8,0">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding StatusItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CommandItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="status-label" Text="{Binding Label}" />
                <TextBlock Classes="status-value" Text="{Binding Description}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Column="1"
                   Classes="status-label"
                   HorizontalAlignment="Right"
                   Text="{Binding StatusText}" />
      </Grid>
    </Border>

    <!-- 菜单条 -->
    <Border DockPanel.Dock="Top" Classes="app-menubar" IsVisible="{Binding ShowMenuBar}">
      <ItemsControl x:Name="menuBar" ItemsSource="{Binding MenuItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CommandItemViewModel">
            <Button Classes="menubar-item"
                    Content="{Binding Label}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
                  <ItemsControl ItemsSource="{Binding Children}" MinWidth="220">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:CommandItemViewModel">
                        <Panel>
                          <Separator Classes="menu-separator" IsVisible="{Binding IsSeparator}" />
                          <Button Classes="menu-item"
                                  IsVisible="{Binding !IsSeparator}"
                                  IsEnabled="{Binding IsEnabled}"
                                  ToolTip.Tip="{Binding DisabledReason}"
                                  Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).InvokeCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" />
                              <TextBlock Grid.Column="1"
                                         Classes="menu-gesture"
                                         Margin="24,0,0,0"
                                         Text="{Binding Gesture}" />
                            </Grid>
                          </Button>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- 工具栏：内容可能比窗口宽，因此放进横向滚动容器，宁可滚动也不裁切 -->
    <Border DockPanel.Dock="Top" Classes="app-toolbar" IsVisible="{Binding ShowToolbar}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding ToolbarItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CommandItemViewModel">
              <Panel>
                <Rectangle x:Name="toolbarSeparator"
                           Classes="toolbar-separator"
                           IsVisible="{Binding IsSeparator}" />
                <Button x:Name="toolbarButton"
                        Classes="toolbar-button"
                        Content="{Binding Label}"
                        IsVisible="{Binding !IsSeparator}"
                        IsEnabled="{Binding IsEnabled}"
                        ToolTip.Tip="{Binding DisabledReason}"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).InvokeCommand}"
                        CommandParameter="{Binding}" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 文档区 + 面板树（内容来自布局配置） -->
    <ContentControl x:Name="layoutHost" Content="{Binding LayoutRoot}" Margin="6" />
  </DockPanel>
</Window>
