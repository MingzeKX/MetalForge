<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MetalForge.App.ViewModels"
        x:Class="MetalForge.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource MfBackground}"
        Width="1280" Height="720">
  <!--
    经典 IDE 布局的容器部分：菜单栏（可选）、工具栏（可选）、中央面板树、状态栏（可选）。
    中央那棵树由 LayoutControlBuilder 从 assets/layouts/*.layout.json 构建，
    因此这里没有硬编码的栏位结构。
  -->
  <DockPanel LastChildFill="True">

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom"
            Classes="app-statusbar"
            IsVisible="{Binding ShowStatusBar}"
            Height="{DynamicResource MfStatusBarHeight}">
      <Grid ColumnDefinitions="Auto,*" Margin="8,0">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding StatusItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CommandItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="status-label" Text="{Binding Label}" />
                <TextBlock Classes="status-value" Text="{Binding Description}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Column="1"
                   Classes="status-label"
                   HorizontalAlignment="Right"
                   Text="{Binding StatusText}" />
      </Grid>
    </Border>

    <!-- 菜单栏 -->
    <Menu DockPanel.Dock="Top"
          Classes="app-menu"
          IsVisible="{Binding ShowMenuBar}"
          ItemsSource="{Binding MenuItems}">
      <Menu.ItemTemplate>
        <DataTemplate DataType="vm:CommandItemViewModel">
          <MenuItem Header="{Binding Label}"
                    ItemsSource="{Binding Children}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip.Tip="{Binding DisabledReason}">
            <MenuItem.ItemTemplate>
              <DataTemplate DataType="vm:CommandItemViewModel">
                <MenuItem Header="{Binding Label}"
                          IsEnabled="{Binding IsEnabled}"
                          InputGesture="{Binding Gesture}"
                          ToolTip.Tip="{Binding DisabledReason}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).InvokeCommand}"
                          CommandParameter="{Binding}" />
              </DataTemplate>
            </MenuItem.ItemTemplate>
          </MenuItem>
        </DataTemplate>
      </Menu.ItemTemplate>
    </Menu>

    <!-- 工具栏 -->
    <Border DockPanel.Dock="Top" Classes="app-toolbar" IsVisible="{Binding ShowToolbar}">
      <ItemsControl ItemsSource="{Binding ToolbarItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CommandItemViewModel">
            <StackPanel>
              <Rectangle x:Name="separator"
                         Width="1"
                         Height="{DynamicResource MfToolbarHeight}"
                         Fill="{DynamicResource MfBorder}"
                         IsVisible="{Binding IsSeparator}" />
              <Button x:Name="commandButton"
                      Content="{Binding Label}"
                      IsVisible="{Binding !IsSeparator}"
                      IsEnabled="{Binding IsEnabled}"
                      ToolTip.Tip="{Binding DisabledReason}"
                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).InvokeCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- 文档区 + 面板树（内容来自布局配置） -->
    <ContentControl x:Name="layoutHost" Content="{Binding LayoutRoot}" Margin="6" />
  </DockPanel>
</Window>
