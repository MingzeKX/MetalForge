<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    全局样式。设计约束：这里不出现任何颜色或尺寸字面量 ——
    全部通过 DynamicResource 引用主题资源键（Mf*），
    由 ThemeResourceService 从 assets/themes/*.theme.json 翻译而来。
    NoHardCodedVisualsTests 会扫描本文件，出现 #RRGGBB 或 Colors.X 即测试失败。
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource MfBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeBase}" />
  </Style>

  <!-- 面板外框：靠背景明度与圆角分层，不用分割线 -->
  <Style Selector="Border.panel-chrome">
    <Setter Property="Background" Value="{DynamicResource MfSurface}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource MfSpace1}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- 面板内的标签控件：去掉 TabControl 自带边框，只保留标签条 -->
  <Style Selector="TabControl.tool-panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TabControl.tool-panel > TabItem">
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeSmall}" />
    <Setter Property="Padding" Value="8,5,8,6" />
    <Setter Property="MinHeight" Value="{DynamicResource MfTabHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TabControl.tool-panel > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
  </Style>

  <!--
    文档区的标签条：把 TabControl 的模板换掉，只保留标签条与选中指示。
    默认模板里的 PART_SelectedContentHost 会覆盖在其下方的内容宿主之上，
    导致"内容创建正确、尺寸正常，但屏幕上什么都看不到"（本项目真实踩过）。
    文档区的内容由 DocumentAreaView 自己按选中项创建，因此这里不需要内容宿主。
  -->
  <Style Selector="TabControl.document-tabs">
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabControl.document-tabs > TabItem">
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeBase}" />
    <!--
      垂直内边距要足够：Fluent 的选中指示条贴在 TabItem 底边，
      若内容几乎填满，指示条就会紧贴文件名（用户反馈"下划线太高、贴到文件名下面"）。
      这里给上下各留出间距，让指示条落在标签下方的空白处。
    -->
    <Setter Property="Padding" Value="10,6,6,8" />
    <Setter Property="MinHeight" Value="{DynamicResource MfTabHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TabControl.document-tabs > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
  </Style>

  <!-- 文档内容区背景：靠明度与圆角和工具面板区分 -->
  <Style Selector="Border.document-surface">
    <Setter Property="Background" Value="{DynamicResource MfSurface}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadius}" />
  </Style>

  <!--
    标签页上的关闭按钮。默认 Fluent 按钮在这里是一个"圆角大按钮"（带背景与焦点环），
    与 IDE 惯例不符。这里做成 16x16 的紧凑 ✕：无背景、无边框、无焦点环，
    仅在悬停时给一点底色。
  -->
  <Style Selector="Button.tab-close">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadiusSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfSurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.tab-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfAccentPressed}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.tab-close:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.tab-close:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MfAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- 占位内容：颜色使用 muted 而不是错误色 —— 未实现不是错误 -->
  <Style Selector="TextBlock.panel-placeholder">
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeSmall}" />
  </Style>

  <!--
    顶部菜单条：Button + Flyout 自建（不是 Avalonia 的 Menu 控件）。
    原因：Menu 的默认模板内建下拉箭头，且模板部件未公开，样式改不掉；
    而 IDE 的惯例是"点击标题弹出列表"（同 Windows 右键菜单），没有箭头。
  -->
  <Style Selector="Border.app-menubar">
    <Setter Property="Background" Value="{DynamicResource MfSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MfBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,2" />
  </Style>

  <Style Selector="Button.menubar-item">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadiusSmall}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.menubar-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfSurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.menubar-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfAccentPressed}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.menubar-item:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- 弹出菜单里的条目：左对齐、占满整行（像 Windows 右键菜单） -->
  <Style Selector="Button.menu-item">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadiusSmall}" />
  </Style>

  <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfSurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.menu-item:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.menu-item:disabled">
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundDisabled}" />
  </Style>

  <Style Selector="TextBlock.menu-gesture">
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Separator.menu-separator">
    <Setter Property="Background" Value="{DynamicResource MfBorder}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
  </Style>

  <!-- 工具栏 -->
  <Style Selector="Border.app-toolbar">
    <Setter Property="Background" Value="{DynamicResource MfSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MfBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!--
    工具栏按钮：三个真实问题一起修
      1) 默认 Fluent 按钮内边距很大；1024 宽的窗口里 11 个按钮会超出宽度，
         实测"停止"之后的条目全被窗口右边缘裁掉（用户描述的"挤压"）；
      2) 点击后出现蓝色焦点/选中描边，用户明确表示不想要；
      3) 按钮高度撑满工具栏，显得臃肿。
    注意：去掉的是**鼠标**点击产生的焦点视觉；键盘导航的焦点环仍然保留（可访问性要求）。
  -->
  <Style Selector="Button.toolbar-button">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadiusSmall}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.toolbar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfSurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.toolbar-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MfAccentPressed}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- 鼠标点击后不显示焦点环；键盘 Tab 导航（focus-visible）时仍然显示 -->
  <Style Selector="Button.toolbar-button:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.toolbar-button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MfAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Rectangle.toolbar-separator">
    <Setter Property="Fill" Value="{DynamicResource MfBorder}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="6,0" />
  </Style>

  <!-- 状态栏 -->
  <Style Selector="Border.app-statusbar">
    <Setter Property="Background" Value="{DynamicResource MfSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MfBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.status-label">
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.status-value">
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 通用文本层级 -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MfForeground}" />
  </Style>

  <Style Selector="TextBlock.subheading">
    <Setter Property="FontSize" Value="{DynamicResource MfFontSizeBase}" />
    <Setter Property="Foreground" Value="{DynamicResource MfAccent}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource MfForegroundMuted}" />
  </Style>

  <!-- 语义状态文本 -->
  <Style Selector="TextBlock.status-ok">
    <Setter Property="Foreground" Value="{DynamicResource MfSuccess}" />
  </Style>

  <Style Selector="TextBlock.status-warn">
    <Setter Property="Foreground" Value="{DynamicResource MfWarning}" />
  </Style>

  <Style Selector="TextBlock.status-danger">
    <Setter Property="Foreground" Value="{DynamicResource MfDanger}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MfEditorFontFamily}" />
  </Style>

  <!-- 卡片：用于工具链健康检查等列表 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource MfSurfaceRaised}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MfCornerRadiusSmall}" />
    <Setter Property="Padding" Value="{DynamicResource MfSpace3}" />
  </Style>

  <Style Selector="GridSplitter.layout-splitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
